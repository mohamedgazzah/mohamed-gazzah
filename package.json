{
  "name": "the-record",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:vercel": "npm run db:migrate && npm run check:no-demo && npm run build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:setup": "tsx --conditions=react-server scripts/db-setup.ts",
    "db:migrate": "tsx --conditions=react-server scripts/db-migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed-demo.ts",
    "admin:create": "tsx --conditions=react-server scripts/create-admin.ts",
    "check:no-demo": "tsx --conditions=react-server scripts/check-no-demo.ts",
    "dictionary": "tsx --conditions=react-server scripts/generate-dictionary.ts",
    "news:scan": "tsx --conditions=react-server scripts/news-scan.ts",
    "geo:build": "node scripts/build-geo.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "test:db-down": "tsx --conditions=react-server scripts/test-db-down.ts",
    "test:lighthouse": "tsx scripts/lighthouse.ts",
    "test:all": "npm run typecheck && npm run test && npm run test:e2e && npm run test:db-down"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "aws4fetch": "^1.0.20",
    "d3-geo": "^3.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.62.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "drizzle-kit": "^0.31.11",
    "lighthouse": "^13.5.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "us-atlas": "^3.0.1",
    "vitest": "^5.0.5"
  }
}
