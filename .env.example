# ---------------------------------------------------------------------------
# Copy to .env for local development. Never commit .env.
# ---------------------------------------------------------------------------

# "development" | "test" | "production". Demo seeding refuses to run in production.
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database --------------------------------------------------------------
# Three connections, three roles (see docs/DEPLOY.md):
#   MIGRATION_DATABASE_URL  schema owner. Migrations and scripts only.
#   DATABASE_URL            record_app: the admin area. No direct write access
#                           to published records, audit log or reviews.
#   PUBLIC_DATABASE_URL     record_public: public pages, downloads, sitemap.
#                           Can read only the record_public views.
MIGRATION_DATABASE_URL=postgres://record_owner:record_owner_dev@localhost:5432/record_dev
DATABASE_URL=postgres://record_app:record_app_dev@localhost:5432/record_dev
PUBLIC_DATABASE_URL=postgres://record_public:record_public_dev@localhost:5432/record_dev
# Local only: a superuser used by `npm run db:setup` to create roles and extensions.
POSTGRES_SUPERUSER_URL=postgres://postgres:postgres@localhost:5432/postgres
# Integration tests create and drop this database.
TEST_DATABASE_NAME=record_test

# --- Secrets (generate each with: openssl rand -base64 32) ---------------------
# Encrypts admin TOTP secrets.
APP_ENCRYPTION_KEY=
# Encrypts submitter contact details, exact addresses and uploaded files.
SUBMISSIONS_ENCRYPTION_KEY=
# HMAC key for rate-limit buckets (raw IPs are never stored).
RATE_LIMIT_SECRET=
# Bearer token scheduled jobs must send to /api/jobs/*.
CRON_SECRET=

# --- Report form spam protection (Cloudflare Turnstile, free) --------------------
# The values below are Cloudflare's documented always-pass test keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Set to "true" only in automated tests.
TURNSTILE_DISABLED=false

# --- Uploaded evidence storage ------------------------------------------------
# "local" writes encrypted files to STORAGE_LOCAL_DIR (development only).
# "s3" uses any private S3-compatible bucket (Supabase Storage, R2, S3).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Source archiving (Internet Archive Save Page Now, free) ----------------------
# Optional keys from https://archive.org/account/s3.php raise the rate limit.
WAYBACK_ACCESS_KEY=
WAYBACK_SECRET_KEY=

# --- Map basemap (MapLibre style URLs; OpenFreeMap needs no key) -----------------
NEXT_PUBLIC_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark

# --- Cookie-free analytics (optional: Plausible or Umami script URL + site id) ---
NEXT_PUBLIC_ANALYTICS_SCRIPT=
NEXT_PUBLIC_ANALYTICS_SITE_ID=

# --- Hosted Postgres TLS (production) --------------------------------------------
# PEM of the database's root CA (Supabase: Database settings > SSL > Download
# certificate). Literal "\n" sequences are accepted for single-line env vars.
DATABASE_CA_CERT=
